@model Consulta

@{
    ViewData["Title"] = "Excluir consulta";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1>Excluir consulta</h1>

        <p class="text-danger">
            Tem certeza de que deseja excluir esta consulta?
        </p>

        <dl class="row">
            <dt class="col-sm-3">Pet</dt>
            <dd class="col-sm-9">@Model.NomePet</dd>

            <dt class="col-sm-3">Especialidade</dt>
            <dd class="col-sm-9">@Model.Especialidade</dd>

            <dt class="col-sm-3">Data e hora</dt>
            <dd class="col-sm-9">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Sintomas</dt>
            <dd class="col-sm-9">@Model.Descricao</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Excluir
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancelar
            </a>
        </form>
    </div>
</div>