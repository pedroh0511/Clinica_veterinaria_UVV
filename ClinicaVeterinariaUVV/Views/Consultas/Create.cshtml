@model Consulta

@{
    ViewData["Title"] = "Agendar consulta";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1>Agendar consulta veterinária</h1>

        <p class="text-muted">
            Informe os dados do pet e os sintomas observados.
        </p>

        <form asp-action="Create" method="post">
            <partial name="_Formulario" model="Model" />

            <button type="submit" class="btn btn-success">
                Agendar consulta
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancelar
            </a>
        </form>
    </div>
</div>